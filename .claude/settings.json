{
  "cleanupPeriodDays": 90,
  "includeCoAuthoredBy": false,
  "includeGitInstructions": false,
  "permissions": {
    "deny": [
      "Read(**/.env)",
      "Read(**/.env.local)",
      "Read(**/.env.local.*)",
      "Read(**/.env.dev)",
      "Read(**/.env.development)",
      "Read(**/.env.staging)",
      "Read(**/.env.stage)",
      "Read(**/.env.production)",
      "Read(**/.env.prod)",
      "Read(.env)",
      "Read(.env.local)",
      "Read(**/secrets.*)",
      "Read(**/credentials.*)",
      "Read(**/*secret*)",
      "Read(**/*token*.json)",
      "Read(**/*token*.txt)",
      "Read(**/*token*.yml)",
      "Read(**/*token*.yaml)",
      "Read(**/*token*.env)",
      "Read(**/*token*.pem)",
      "Read(**/*token*.key)",
      "Read(**/.*token*)",
      "Read(**/*.token)",
      "Read(~/.ssh/*)",
      "Read(~/.aws/credentials)",
      "Read(~/.npmrc)",
      "Read(~/.gitconfig)",
      "Read(/etc/passwd)",
      "Read(/etc/shadow)",
      "Write(**/.env)",
      "Write(**/.env.dev)",
      "Write(**/.env.development)",
      "Write(**/.env.staging)",
      "Write(**/.env.stage)",
      "Write(**/.env.production)",
      "Write(**/.env.prod)",
      "Write(**/secrets.*)",
      "Write(~/.ssh/*)",
      "Write(~/.aws/credentials)",
      "Edit(**/.env)",
      "Edit(**/.env.dev)",
      "Edit(**/.env.development)",
      "Edit(**/.env.staging)",
      "Edit(**/.env.stage)",
      "Edit(**/.env.production)",
      "Edit(**/.env.prod)",
      "Edit(**/secrets.*)",
      "Edit(~/.ssh/*)",
      "Bash(rm -rf*)",
      "Bash(rm -rf *)",
      "Bash(sudo rm*)",
      "Bash(sudo *)",
      "Bash(sudo)",
      "Bash(chmod 777*)",
      "Bash(chown*)",
      "Bash(mkfs*)",
      "Bash(dd if=*)",
      "Bash(wget*)",
      "Bash(wget *)",
      "Bash(nc*)",
      "Bash(netcat*)",
      "Bash(ssh*)",
      "Bash(scp*)",
      "Bash(rsync*)",
      "Bash(eval*)",
      "Bash(python -c*)",
      "Bash(python3 -c*)",
      "Bash(node -e*)",
      "Bash(node -p*)",
      "Bash(perl -e*)",
      "Bash(ruby -e*)",
      "Bash(bash -c*)",
      "Bash(sh -c*)",
      "Bash(zsh -c*)",
      "Bash(base64 --decode*)",
      "Bash(echo * | bash*)",
      "Bash(bash <(curl*))",
      "Bash(bash <(wget*))"
    ],
    "defaultMode": "bypassPermissions"
  },
  "model": "claude-fable-5[1m]",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/scripts/pre-push-gate.sh",
            "timeout": 10,
            "statusMessage": "Pre-push policy check"
          }
        ]
      }
    ],
    "Notification": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "osascript -e 'display notification \"Claude needs your input\" with title \"Claude Code\" sound name \"Hero\"' -e 'set d to display dialog \"Claude Code is waiting for your response. Click to return to the terminal.\" with title \"Claude Code\" buttons {\"Go to terminal\"} default button \"Go to terminal\" giving up after 60' -e 'if gave up of d is false then tell application \"Terminal\" to activate'",
            "async": true
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "~/.claude/scripts/statusline.sh"
  },
  "extraKnownMarketplaces": {
    "personal": {
      "source": {
        "source": "directory",
        "path": "~/Documents/Work/Projects/AI/claude-plugins"
      }
    }
  },
  "enabledPlugins": {
    "swift-lsp@claude-plugins-official": true,
    "figma@claude-plugins-official": true,
    "pre-push-review@personal": true,
    "daily@personal": true,
    "guardrails@personal": true,
    "coach@personal": true,
    "sdlc@personal": true,
    "reviewers@personal": true,
    "fly-ops@personal": true,
    "lsp@personal": true,
    "monitors@personal": true,
    "mcp-catalog@personal": true,
    "seo@personal": true,
    "research@personal": true,
    "content@personal": true,
    "reports@personal": true,
    "biz@personal": true
  },
  "spinnerTipsEnabled": false,
  "effortLevel": "medium",
  "promptSuggestionEnabled": false,
  "tui": "fullscreen",
  "skipDangerousModePermissionPrompt": true,
  "theme": "auto",
  "autoCompactEnabled": true,
  "fileCheckpointingEnabled": true,
  "showTurnDuration": true,
  "inputNeededNotifEnabled": true,
  "voiceEnabled": true
}
